# =============================================================================
#  .env.example — TracerLensAi Configuration
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  .env is in .gitignore — it will NOT be committed.
# =============================================================================

# ── GCP Project ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=europe-west2

# ── Artifact Registry (Docker image storage) ─────────────────────────────────
AR_REGISTRY=europe-west2-docker.pkg.dev
AR_REPO=agent-docker-repo
IMAGE_NAME=tracerlensai-orchestrator

# ── GKE Cluster (for manual deploy only — CI/CD uses GitHub Variables) ───────
GKE_CLUSTER_NAME=agentic-orchestrator-cluster
GKE_CLUSTER_ZONE=europe-west2

# ── Helm / Kubernetes ────────────────────────────────────────────────────────
HELM_RELEASE_NAME=tracerlensai
K8S_NAMESPACE=staging

# ── Optional: API Keys (for local development) ──────────────────────────────
# OPENAI_API_KEY=sk-your-key
# ANTHROPIC_API_KEY=your-key
