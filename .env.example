# =============================================================================
#  .env.example — TracerLensAi Configuration
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  .env is in .gitignore — it will NOT be committed.
# =============================================================================

# ── GCP Project ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=europe-west2

# ── Vertex AI Location ───────────────────────────────────────────────────────
# The region where Vertex AI models are served. Keep this equal to
# GOOGLE_CLOUD_REGION: the project's *global* Gemini quota is exhausted while the
# regional endpoint is healthy, so src/agent.py rewrites a "global" value to the
# region on import, and docker-compose.dev.yml forces it. A stale us-central1
# here fails in confusing ways.
GOOGLE_CLOUD_LOCATION=europe-west2

# ── Optional: Gemini API Key (for local development without ADC) ─────────────
# If set, the app uses direct API key auth instead of Vertex AI / ADC.
# Get a key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key

# ── Artifact Registry (Docker image storage) ─────────────────────────────────
AR_REGISTRY=europe-west2-docker.pkg.dev
AR_REPO=agent-docker-repo
IMAGE_NAME=tracerlensai-app

# =============================================================================
#  Access gate — see docs/access_control.md
#
#  The chat agent is gated: visitors request access by email, you approve, and
#  each approved address gets a token quota. None of these are needed for local
#  mock mode (emails print to the console, records live in memory), but all of
#  them are required in production.
# =============================================================================

# ── Email delivery ───────────────────────────────────────────────────────────
# Transport precedence: SMTP → Resend → print to stdout. With neither
# configured every email is printed instead of sent, which is what makes the
# offline dev loop and the E2E suite work with no credentials.
#
# Option A — SMTP, e.g. a personal Gmail. All four of HOST/PORT/USER/PASSWORD
# must be set or SMTP is treated as off. Gmail specifically needs an App
# Password (16 characters, no spaces), which requires 2-Step Verification on
# the account; the normal account password is rejected. Create one at
# https://myaccount.google.com/apppasswords
# Note Gmail's ~500 messages/day limit, and that it rewrites the From header to
# SMTP_USER regardless of ACCESS_FROM_EMAIL.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
#
# Option B — Resend. Note it can only send from a domain you have verified via
# DNS, so an @gmail.com sender is not possible here; use SMTP for that.
# RESEND_API_KEY=re_your_api_key
ACCESS_NOTIFY_EMAIL=jacobbinu4488code@gmail.com
# Must be a sender you have verified with Resend. Leave unset when using SMTP —
# it then defaults to SMTP_USER, which is what the recipient sees anyway.
ACCESS_FROM_EMAIL=Tracer Lens <hello@tracerlensai.com>

# ── Signing & admin ──────────────────────────────────────────────────────────
# Signs sessions, sign-in links, and the one-click approve/deny links.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset ⇒ an ephemeral per-process key, so every restart signs everyone out.
# Rotating it deliberately is how you sign everyone out at once.
# ACCESS_SIGNING_SECRET=
# First factor for /admin; the second is a one-time code emailed to
# ACCESS_NOTIFY_EMAIL. Unset ⇒ the admin dashboard is unreachable (503).
# ADMIN_TOKEN=
# Public origin of the site — sign-in links and admin links are built from it.
APP_URL=https://tracerlensai.com

# ── Quota & retention ────────────────────────────────────────────────────────
ACCESS_TOKEN_LIMIT=200000       # starting cap per approved address
ACCESS_TOKEN_GRANT=200000       # added (not reset) per approved extension
CHAT_RETENTION_HOURS=24         # promised in the privacy notice — see the docs
                                # before changing it
RUN_METRICS_RETENTION_DAYS=30   # dashboard rows; metadata only, no chat content

# ── Local development only ───────────────────────────────────────────────────
# Keeps access records in a process-local dict so the gate works with no cloud
# credentials. docker/local-entrypoint.sh sets this automatically for MODE=mock.
# NEVER set this in production — every approval is lost on restart.
# ACCESS_STORE=memory

# ── Multi-environment deploys ────────────────────────────────────────────────
# Read by the code or by deploy_to_gcp.sh, and set per tier by the three
# deploy workflows (.github/workflows/deploy{,-dev,-staging}.yml) from their
# GitHub Environments. Listed here because they change behaviour and were
# otherwise undocumented — none needs setting for a normal local run.

# Which named Firestore database the access gate reads and writes.
# proxy/access.py defaults to "tracerlensai", which is production's. The dev
# and staging environments set their own so preview approvals and quota never
# mutate live records; production leaves it unset so the default applies.
# FIRESTORE_DATABASE_ID=tracerlensai-dev

# Retargets deploy_to_gcp.sh's proxy stage at a different Cloud Run service.
# This is what lets a preview deploy exist without touching tracerlensai-app.
# Deliberately not called SERVICE_NAME or IMAGE_NAME: this file is sourced by
# that script, and .env already defines IMAGE_NAME for the GKE path — reusing
# either name would let a local .env silently retarget a production deploy.
# DEPLOY_SERVICE_NAME=tracerlensai-app-dev

# Comma-separated browser origins allowed to call the API cross-origin. Only
# needed when the UI is served from a different host than the API; empty
# leaves the CORS middleware inert. deploy_to_gcp.sh defaults it to the
# production domains.
# CORS_ORIGINS=https://tracerlensai.com,https://api.tracerlensai.com

# Explicit Agent Engine query endpoint. Normally left unset: deploy_to_gcp.sh
# derives it from deployment_metadata.json, which agents-cli keeps current on
# every agent deploy. An explicit value here overrides that and can go stale.
# AGENT_ENGINE_ENDPOINT=

# Escape hatch for the APP_URL startup guard. On a managed runtime (Cloud Run
# sets K_SERVICE) proxy/access.py refuses to start without APP_URL, because
# every emailed sign-in link would otherwise point at localhost. Set this only
# to deliberately allow that — it is not needed for local development, where
# the guard is inactive anyway.
# ALLOW_LOCALHOST_APP_URL=1
