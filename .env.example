# =============================================================================
#  .env.example — TracerLensAi Configuration
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  .env is in .gitignore — it will NOT be committed.
# =============================================================================

# ── GCP Project ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=europe-west2

# ── Vertex AI Location ───────────────────────────────────────────────────────
# The region where Vertex AI models are served.
# This is read by main.py as GOOGLE_CLOUD_LOCATION (falls back to GOOGLE_CLOUD_REGION).
GOOGLE_CLOUD_LOCATION=us-central1

# ── Optional: Gemini API Key (for local development without ADC) ─────────────
# If set, the app uses direct API key auth instead of Vertex AI / ADC.
# Get a key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key

# ── Artifact Registry (Docker image storage) ─────────────────────────────────
AR_REGISTRY=europe-west2-docker.pkg.dev
AR_REPO=agent-docker-repo
IMAGE_NAME=tracerlensai-app
