    {
      "eval_case_id": "mediator_must_not_be_adjusted",
      "prompt": {
        "role": "user",
        "parts": [
          {
            "text": "[[causal:on]] What is the total effect of job training on earnings? Training raises skills, and skills raise earnings; family background affects both training uptake and earnings. Should the analysis control for skills?"
          }
        ]
      },
      "reference": {
        "response": {
          "role": "model",
          "parts": [
            {
              "text": "No - skills is a MEDIATOR on the causal path training -> skills -> earnings. Controlling for it would block part of the effect and bias the total effect toward zero (overadjustment). The correct back-door adjustment set is {family background} only. Adjust for confounders, never for mediators, when estimating a total effect."
            }
          ]
        }
      }
    },
    {
      "eval_case_id": "collider_must_not_be_adjusted",
      "prompt": {
        "role": "user",
        "parts": [
          {
            "text": "[[causal:on]] We study whether exercise affects heart disease. Both exercise and heart disease influence hospital admission. Should we restrict the analysis to hospitalized patients or control for hospitalization?"
          }
        ]
      },
      "reference": {
        "response": {
          "role": "model",
          "parts": [
            {
              "text": "No - hospitalization is a COLLIDER (exercise -> hospitalization <- heart disease). Conditioning on it (restriction or adjustment) opens a spurious association between exercise and heart disease (collider/selection bias, Berkson's paradox). The analysis must NOT condition on hospitalization."
            }
          ]
        }
      }
    },
