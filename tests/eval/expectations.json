        "require_identifiable": true
      }
    },
    "collider_must_not_be_adjusted": {
      "_note": "hospitalization is a COLLIDER (exercise -> hospitalization <- heart disease). Conditioning on it opens a spurious path, so it must be absent from the adjustment set.",
